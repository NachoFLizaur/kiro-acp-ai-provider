{
  "name": "kiro-acp-ai-provider",
  "version": "2.1.2",
  "description": "Kiro ACP (AWS) provider for Vercel AI SDK",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ipc": {
      "types": "./dist/ipc.d.ts",
      "import": "./dist/ipc.js",
      "require": {
        "types": "./dist/ipc.d.cts",
        "default": "./dist/ipc.cjs"
      }
    },
    "./mcp-bridge": {
      "import": "./dist/mcp-bridge.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.bridge.config.ts && tsup",
    "dev": "tsup --config tsup.bridge.config.ts && tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@ai-sdk/provider": ">=3.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "bun-types": "latest",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "kiro",
    "acp",
    "ai-sdk",
    "vercel",
    "language-model",
    "aws",
    "agent-client-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NachoFLizaur/kiro-acp-ai-provider.git"
  },
  "bugs": {
    "url": "https://github.com/NachoFLizaur/kiro-acp-ai-provider/issues"
  },
  "homepage": "https://github.com/NachoFLizaur/kiro-acp-ai-provider#readme",
  "author": {
    "name": "Nacho F. Lizaur",
    "url": "https://github.com/NachoFLizaur"
  }
}
